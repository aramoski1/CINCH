# apps/web/.env.local — Next.js. On Vercel, leave NEXT_PUBLIC_API_BASE_URL empty
# so the phone talks to /v1 on the same site. Copy the API secrets onto Vercel too.

NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_API_BASE_URL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
INTERNAL_ADMIN_TOKEN=

# /i/:code renders server-side with NO signup gate (§11.4).
# Use a narrowly scoped service-role read. Never relax RLS to make it work.
